# Copy to /opt/sen-proxi-teranga/backend.env on the VPS.
# Replace placeholders on the server; never commit the real file.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/sen_proxi_teranga?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=senproxi
SPRING_DATASOURCE_PASSWORD=REPLACE_ON_VPS
# First deployment on an empty database: update. After bootstrap: validate.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SERVER_FORWARD_HEADERS_STRATEGY=framework
APP_UPLOADS_DOSSIER=/app/uploads
ADMIN_EMAIL=admin@senproxiteranga.sn
ADMIN_PASSWORD=REPLACE_ON_VPS
